#!/bin/bash

set -euo pipefail

git -C swiftwasm/swift checkout "$SWIFT_TAG"

MANIFEST="swiftwasm/swift/utils/update_checkout/update-checkout-config.json"
SWIFT_SCHEME="${SWIFT_TAG#swift-}"
SWIFT_SCHEME="${SWIFT_SCHEME%-RELEASE}"

if ! jq -e ".[\"branch-schemes\"] | has(\"release/${SWIFT_SCHEME}\")" "$MANIFEST"; then
    echo "Scheme '${SWIFT_SCHEME}' not found in config, falling back to minor version..."
    SWIFT_SCHEME="${SWIFT_SCHEME%.*}"
fi

echo "checking out tag: ${SWIFT_TAG} with scheme release/${SWIFT_SCHEME}"

swiftwasm/swift/utils/update-checkout \
    --scheme "release/${SWIFT_SCHEME}" \
    --clone \
    --reset-to-remote \
    --match-timestamp \
    --skip-repository swift

# The standard library is compiled with the compiler from the rarestype/swift release in
# $SWIFT_OVERLAY, so it gets the same upstream commits that release cherry-picked.
: "${SWIFT_OVERLAY:?}"
RELEASE="${SWIFT_OVERLAY%-*}"
PINS=$(mktemp)
curl -fsSL -o "$PINS" \
    "https://raw.githubusercontent.com/rarestype/swift/swift-${SWIFT_OVERLAY}/Releases/${RELEASE}"
source "$PINS"

while read -r repository commit; do
    if [[ -z "$repository" ]]; then
        continue
    fi
    git -C "swiftwasm/$repository" fetch --quiet origin "$commit"
    git -C "swiftwasm/$repository" \
        -c user.name="rarest automation" \
        -c user.email="automation@noreply.rarestype.com" \
        cherry-pick -x "$commit"
    echo "cherry-picked swiftlang/${repository}@${commit}"
done <<< "${PATCHES:-}"
